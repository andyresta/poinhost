{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wails-dev",
      "runtimeExecutable": "wails",
      "runtimeArgs": [
        "dev"
      ],
      "port": 34115
    },
    {
      "name": "wails-dev-skipbindings",
      "runtimeExecutable": "wails",
      "runtimeArgs": [
        "dev",
        "-skipbindings"
      ],
      "port": 34115
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/mobile-devproxy",
        "-addr",
        "127.0.0.1:5123"
      ],
      "port": 5123
    }
  ]
}
