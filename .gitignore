build/bin
node_modules
frontend/dist

# Data aplikasi. Normalnya tersimpan di folder data OS (AppData/XDG), BUKAN di
# repo — tapi tetap diabaikan di sini sebagai jaring pengaman: file ini berisi
# daftar server beserta metadata kredensialnya.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Arsip backup poinhost (terenkripsi, tapi tetap tidak untuk repo).
*.poinhostbkp

# Binary agent yang di-embed ke app desktop — artefak build CI, bukan sumber.
# README.md di folder itu SENGAJA tetap di-commit; tanpa file yang cocok,
# pola //go:embed gagal saat kompilasi di clone yang bersih.
internal/agent/dist/bin/*.gz
internal/agent/dist/bin/version.txt
